# Copy to `.env` in this folder before `pnpm dev` (optional — browser TTS works without these).

# Owl / compatible TTS HTTP endpoint (not owlbox.ai NVR — use your Owl TTS install).
VITE_OWL_TTS_URL=http://127.0.0.1:8790

# ComfyUI view URL for agent portrait thumbnails (static fallbacks used when unset).
VITE_COMFYUI_VIEW_URL=http://127.0.0.1:8188/view

# Phase 1: auto-start a demo session + KSP fixture telemetry (no Kerbal installed).
# Set true for fixture-only demo on launch. Leave false when scanning/playing real games.
VITE_TITAN_AUTO_DEMO=false

# Legacy: pin WebSocket to a fixed session UUID instead of the active session chip.
# VITE_TITAN_DEMO_SESSION=
