# Copy to `.env` in this folder before `pnpm dev` (optional — browser TTS works without these).

# Owlbox OpenAI-compatible TTS (local install on :8790). Live session agents speak via this URL.
# Browser speechSynthesis is used only when this is unset or the server is unreachable.
VITE_OWL_TTS_URL=http://127.0.0.1:8790

# ComfyUI /view base for live Ops Center agent portraits (filenames: titan-{slug}.png in output).
# When unset, falls back to VITE_AGENT_PORTRAIT_BASE or /portraits/{slug}.png.
VITE_COMFYUI_VIEW_URL=http://127.0.0.1:8188/view
# VITE_AGENT_PORTRAIT_BASE=http://127.0.0.1:9000/portraits

# Opt-in only: auto-start a fixture demo session on launch (default false in electron-vite build).
VITE_TITAN_AUTO_DEMO=false

# Legacy: pin WebSocket to a fixed session UUID instead of the active session chip.
# VITE_TITAN_DEMO_SESSION=
