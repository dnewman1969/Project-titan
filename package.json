{
  "name": "titan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project Titan: local-first autonomous AI gaming content studio",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @titan/desktop dev",
    "build": "pnpm -r build",
    "codegen": "uv run python tools/codegen.py",
    "codegen:check": "uv run python tools/codegen.py --check",
    "lint": "pnpm lint:ts && pnpm lint:py",
    "lint:ts": "eslint . && prettier --check . && pnpm -r typecheck",
    "lint:py": "uv run ruff check . && uv run ruff format --check . && uv run mypy && uv run python tools/lint-imports/run.py",
    "format": "prettier --write . && uv run ruff format . && uv run ruff check --fix .",
    "test": "pnpm test:ts && pnpm test:py",
    "test:ts": "pnpm -r test",
    "test:py": "uv run pytest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
