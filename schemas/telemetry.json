{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titan.local/schemas/telemetry.json",
  "title": "TelemetryFrame",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "titan.telemetry/1",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "game": {
      "description": "'ksp' | 'ets2' | 'ats' | ...",
      "type": "string"
    },
    "adapter_version": {
      "type": "string"
    },
    "seq": {
      "description": "Per session, monotonic",
      "minimum": 0,
      "type": "integer"
    },
    "t_mono_ns": {
      "type": "integer"
    },
    "t_session_ms": {
      "type": "integer"
    },
    "t_game_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "KSP UT seconds; SCS game time in seconds"
    },
    "paused": {
      "type": "boolean"
    },
    "scene": {
      "description": "ksp: flight|map|vab|sph|space_center|tracking|menu ; scs: driving|menu|loading|map",
      "type": "string"
    },
    "domain": {
      "enum": [
        "space",
        "ground_vehicle",
        "aircraft",
        "naval",
        "strategy",
        "other"
      ],
      "type": "string"
    },
    "vehicle": {
      "$ref": "#/$defs/Vehicle"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/Resource"
      },
      "type": "array"
    },
    "environment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Environment"
        },
        {
          "type": "null"
        }
      ]
    },
    "job": {
      "anyOf": [
        {
          "$ref": "#/$defs/Job"
        },
        {
          "type": "null"
        }
      ]
    },
    "economy": {
      "anyOf": [
        {
          "$ref": "#/$defs/Economy"
        },
        {
          "type": "null"
        }
      ]
    },
    "game_specific": {
      "additionalProperties": true,
      "description": "Adapter-defined, documented in the game package README",
      "type": "object"
    }
  },
