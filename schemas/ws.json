{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titan.local/schemas/ws.json",
  "title": "WebSocket protocol",
  "x-titan-ws-message-types": {
    "chat.start": "#/$defs/ChatStartData",
    "chat.delta": "#/$defs/ChatDeltaData",
    "chat.final": "#/$defs/ChatFinalData",
    "chat.cancelled": "#/$defs/ChatCancelledData",
    "user.say": "#/$defs/UserSayData",
    "system.notice": "#/$defs/SystemNoticeData",
    "agent.state": "#/$defs/AgentStateData",
    "task.update": "#/$defs/TaskUpdateData",
    "floor.state": "#/$defs/FloorStateData",
    "bb.update": "#/$defs/BBUpdateData",
    "telemetry.frame": "#/$defs/TelemetryFrameUI",
    "game.event": "#/$defs/GameEvent",
    "session.state": "#/$defs/SessionStateData",
    "session.ended": "#/$defs/SessionEndedData",
    "recording.status": "#/$defs/RecordingStatus",
    "system.metrics": "#/$defs/SystemMetrics",
    "safety.state": "#/$defs/SafetyState",
    "job.update": "#/$defs/JobUpdateData"
  },
  "$defs": {
    "AckError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "detail"
      ],
      "title": "AckError",
      "type": "object"
    },
    "AckFrame": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ack",
          "type": "string"
        },
        "req_id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AckError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "op",
        "req_id",
        "ok"
      ],
      "title": "AckFrame",
      "type": "object"
    },
    "AgentStateData": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "state": {
          "enum": [
            "spawning",
            "ready",
            "busy",
            "paused",
            "terminating",
            "terminated",
            "crashed"
          ],
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "instance_id",
        "state"
      ],
      "title": "AgentStateData",
      "type": "object"
    },
    "Attitude": {
      "additionalProperties": false,
      "properties": {
        "heading_deg": {
          "type": "number"
        },
        "pitch_deg": {
          "type": "number"
        },
        "roll_deg": {
          "type": "number"
        }
      },
      "required": [
        "heading_deg",
        "pitch_deg",
        "roll_deg"
      ],
      "title": "Attitude",
      "type": "object"
    },
    "AuthFrame": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "auth",
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "client": {
          "description": "e.g. 'desktop/1.0.0'",
          "type": "string"
        }
      },
      "required": [
        "op",
        "token",
        "client"
      ],
      "title": "AuthFrame",
      "type": "object"
    },
    "BBUpdateData": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        },
        "author": {
          "type": "string"
        }
      },
      "required": [
        "section",
        "key",
        "version",
        "author"
      ],
      "title": "BBUpdateData",
      "type": "object"
    },
    "ChatCancelledData": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "format": "uuid",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "reason"
      ],
      "title": "ChatCancelledData",
      "type": "object"
    },
    "ChatDeltaData": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "format": "uuid",
          "type": "string"
        },
        "delta": {
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "delta"
      ],
      "title": "ChatDeltaData",
      "type": "object"
    },
    "ChatFinalData": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "format": "uuid",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "mentions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "message_id",
        "text",
        "tokens",
        "model",
        "latency_ms",
        "mentions"
      ],
      "title": "ChatFinalData",
      "type": "object"
    },
    "ChatSender": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "persona_slug": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "color_hex": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "portrait_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "instance_id",
        "persona_slug",
        "display_name",
        "role",
        "color_hex",
        "portrait_url"
      ],
      "title": "ChatSender",
      "type": "object"
    },
    "ChatStartData": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "format": "uuid",
          "type": "string"
        },
        "sender": {
          "$ref": "#/$defs/ChatSender"
        },
        "reply_to": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_ref": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "const": "say",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "sender",
        "reply_to",
        "event_ref",
        "kind"
      ],
      "title": "ChatStartData",
      "type": "object"
    },
    "ClientFrame": {
      "description": "Any frame the client may send.",
      "discriminator": {
        "mapping": {
          "auth": "#/$defs/AuthFrame",
          "ping": "#/$defs/PingFrame",
          "subscribe": "#/$defs/SubscribeFrame",
          "unsubscribe": "#/$defs/UnsubscribeFrame"
        },
        "propertyName": "op"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AuthFrame"
        },
        {
          "$ref": "#/$defs/SubscribeFrame"
        },
        {
          "$ref": "#/$defs/UnsubscribeFrame"
        },
        {
          "$ref": "#/$defs/PingFrame"
        }
      ],
      "title": "ClientFrame"
    },
